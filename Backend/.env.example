# SafeLife backend — copy to .env for local dev. NEVER commit .env with real values.
# On Vercel: Project → Settings → Environment Variables.

# httpSMS (SafeLife 2.0 Day 7) — SERVER-SIDE ONLY, never in the app.
# API key from the httpsms.com dashboard; FROM = the gateway Android
# phone's own number, with the httpSMS app installed and listening.
# Until both are set, the SMS channel honestly reports not-configured.
HTTPSMS_API_KEY=
HTTPSMS_FROM=

# WhatsApp Business Cloud API (SafeLife 2.0 Day 8) — SERVER-SIDE ONLY, never in the app.
# Until all three of TOKEN + PHONE_NUMBER_ID + TEMPLATE_NAME are set, the
# WhatsApp channel honestly reports not-configured.
# SETUP (Rishabh's step — business verification ~D8, Oct 31):
#  1. Meta Business account + business verification; create a Meta app,
#     add the WhatsApp product, register/verify the business phone number.
#  2. In Meta Business Settings create an Admin System User, grant it the
#     WhatsApp Business Account, and generate a PERMANENT access token
#     with the whatsapp_business_messaging permission — that is
#     WHATSAPP_ACCESS_TOKEN. (App-dashboard test tokens expire; a
#     permanent token is what production needs.)
#  3. Copy the sending number's Phone Number ID from WhatsApp → API Setup
#     → WHATSAPP_PHONE_NUMBER_ID.
#  4. Create + get APPROVED a UTILITY template named WHATSAPP_TEMPLATE_NAME
#     with NO variables (parameterless — the adapter sends no components).
#     Suggested body (create it with this exact intent; Meta approves the
#     wording, so the approved text is what recipients see):
#       "SafeLife emergency alert: someone who listed you as an emergency
#        contact needs help right now. Check your SMS and Telegram for
#        their live location, or call them immediately."
#     If the approved template carries {{1}} etc. variables, this adapter's
#     sends will be REJECTED by Meta — add parameters only in a live turn
#     against the real approved template, never by guessing.
#  5. Recipients must have opted in to business messages. A 2xx from Meta
#     means accepted, not delivered/read (webhooks would confirm that;
#     none is wired in this program).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Template language code, e.g. en_US (default when unset) or hi.
WHATSAPP_TEMPLATE_LANGUAGE=

# Telegram bot token (create / rotate via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs that receive SOS alerts
TELEGRAM_CHAT_IDS=

# Shared secret for API-key auth on POST /alert, /location-update, /test-alert.
# The mobile app must send the same value as the `x-api-key` header
# (EXPO_PUBLIC_API_SECRET in mobile-app/.env).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=

# Local dev port (Vercel ignores this)
PORT=5000

# CORS allowlist, comma-separated. Unset = no CORS headers (fail closed).
CORS_ALLOWED_ORIGINS=

# Debug test-alert route. Default-deny unless exactly "1".
ENABLE_TEST_ALERT=

# Upstash Redis (SafeLife 2.0 Day 2) — serverless Redis for GEO,
# cross-instance rate limits and the safe-places cache.
# Create a database at upstash.com → copy its REST URL + REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (SafeLife 2.0 Day 2) — delayed jobs for delivery retries and
# the escalation ladder (consumers land Day 4 / Day 10).
# Create a token at upstash.com → QStash.
QSTASH_TOKEN=

# Public base URL for QStash callbacks (SafeLife 2.0 Day 4) — where the
# /delivery-retry endpoint lives. Optional: on Vercel, VERCEL_URL is
# used automatically when this is unset. Set it only for a custom domain
# or a local tunnel (e.g. https://abc.ngrok-free.app). No trailing slash.
PUBLIC_BASE_URL=

# Supabase Postgres (SafeLife 2.0 Day 3) — sos_alerts + audit_events
# tables (supabase/migrations/20261026080000_sos_alerts_audit.sql).
# SUPABASE_URL is the project URL (https://<ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the service_role key from Supabase →
# Settings → API. SERVER-SIDE ONLY: it bypasses RLS — never put it in
# the mobile app, never commit it. Until both are set, alerts live in
# instance memory only and audit stays stdout-only (no behavior change).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
