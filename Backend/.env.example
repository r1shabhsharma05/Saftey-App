# SafeLife backend — copy to .env for local dev. NEVER commit .env with real values.
# On Vercel: Project → Settings → Environment Variables.

# Telegram bot token (create / rotate via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs that receive SOS alerts
TELEGRAM_CHAT_IDS=

# Shared secret for API-key auth on POST /alert, /location-update, /test-alert.
# The mobile app must send the same value as the `x-api-key` header
# (EXPO_PUBLIC_API_SECRET in mobile-app/.env).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=

# Local dev port (Vercel ignores this)
PORT=5000
