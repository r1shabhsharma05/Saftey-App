# SafeLife backend — copy to .env for local dev. NEVER commit .env with real values.
# On Vercel: Project → Settings → Environment Variables.

# httpSMS (SafeLife 2.0 Day 7) — SERVER-SIDE ONLY, never in the app.
# API key from the httpsms.com dashboard; FROM = the gateway Android
# phone's own number, with the httpSMS app installed and listening.
# Until both are set, the SMS channel honestly reports not-configured.
HTTPSMS_API_KEY=
HTTPSMS_FROM=

# FCM push (SafeLife 2.0 Day 9) — SERVER-SIDE ONLY, never in the app.
# Until all three are set, the push channel honestly reports
# not-configured. The values come from ONE service-account key JSON
# (Firebase console → Project settings → Service accounts → Generate
# New Private Key): project_id → FCM_PROJECT_ID, client_email →
# FCM_CLIENT_EMAIL, private_key → FCM_PRIVATE_KEY (paste the PEM with
# its newlines as \n escapes; the adapter normalizes them).
# SETUP (Rishabh's steps — Firebase project + app-side follow-up):
#  1. Create a Firebase project, enable the Firebase Cloud Messaging
#     API (v1) in Cloud Messaging settings.
#  2. Generate the service-account key JSON; split its three fields
#     into the env vars above in Vercel and redeploy.
#  3. APP-SIDE (not done on D9 — needs a decision + EAS build): install
#     expo-notifications, add google-services.json + the FCM config,
#     collect each contact device's registration token and send it as
#     the contact's pushToken with the SOS. Until then push reports
#     no-push-recipients. iOS delivery additionally needs an APNs key
#     uploaded in the Firebase console.
#  4. The contacts-side alert page needs NO extra vars: its per-alert
#     token is HMAC-signed with API_SECRET and the link uses
#     PUBLIC_BASE_URL (or VERCEL_URL on Vercel). Without API_SECRET
#     the page answers 401 for every request.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Voice speech — Gnani Vachana (Prisma STT + Timbre TTS), replaces the
# Day 10 Bolna adapter (2026-11-14, Gnani challenge).
# SERVER-SIDE ONLY, never in the app. Until the key is set, the speech
# routes honestly report not-configured.
# SETUP: copy the Vachana API key (vach_…) from the Gnani console →
# GNANI_API_KEY. The key covers the Vachana Speech APIs only.
# NOTE: Vachana is speech synthesis + recognition — it has NO phone-call
# endpoint. The escalation ladder's voice-call step (step 3) therefore
# honestly reports voice-call-not-supported; placing a real call needs
# the Gnani Agent Builder console agent + its calls API, which is a
# separate piece (no public REST API verified as of 2026-11-14).
# What works on this key: POST /voice/synthesize (Timbre TTS, Hindi
# voice Nalini) and POST /voice/transcribe (Prisma STT, Hinglish via
# indic-auto) — the seams for the voice-trigger SOS and the spoken
# SOS message. First live test must be a supervised check, never a
# real SOS. The ladder only calls contacts who have not ACKed (2
# distinct ACKs stop it).
GNANI_API_KEY=<redacted>

# WhatsApp Business Cloud API (SafeLife 2.0 Day 8) — SERVER-SIDE ONLY, never in the app.
# Until all three of TOKEN + PHONE_NUMBER_ID + TEMPLATE_NAME are set, the
# WhatsApp channel honestly reports not-configured.
# SETUP (Rishabh's step — business verification ~D8, Oct 31):
#  1. Meta Business account + business verification; create a Meta app,
#     add the WhatsApp product, register/verify the business phone number.
#  2. In Meta Business Settings create an Admin System User, grant it the
#     WhatsApp Business Account, and generate a PERMANENT access token
#     with the whatsapp_business_messaging permission — that is
#     WHATSAPP_ACCESS_TOKEN. (App-dashboard test tokens expire; a
#     permanent token is what production needs.)
#  3. Copy the sending number's Phone Number ID from WhatsApp → API Setup
#     → WHATSAPP_PHONE_NUMBER_ID.
#  4. Create + get APPROVED a UTILITY template named WHATSAPP_TEMPLATE_NAME
#     with NO variables (parameterless — the adapter sends no components).
#     Suggested body (create it with this exact intent; Meta approves the
#     wording, so the approved text is what recipients see):
#       "SafeLife emergency alert: someone who listed you as an emergency
#        contact needs help right now. Check your SMS and Telegram for
#        their live location, or call them immediately."
#     If the approved template carries {{1}} etc. variables, this adapter's
#     sends will be REJECTED by Meta — add parameters only in a live turn
#     against the real approved template, never by guessing.
#  5. Recipients must have opted in to business messages. A 2xx from Meta
#     means accepted, not delivered/read (webhooks would confirm that;
#     none is wired in this program).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Template language code, e.g. en_US (default when unset) or hi.
WHATSAPP_TEMPLATE_LANGUAGE=

# Telegram bot token (create / rotate via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs that receive SOS alerts
TELEGRAM_CHAT_IDS=

# Shared secret — server-side signing key for the HMAC capability
# tokens (alert-view, escalation, retry, journey) AND the time-boxed
# compat fallback for old APKs (x-api-key, middleware/requireUser.js).
# Run-2: it is NO LONGER injected into APK builds
# (.github/workflows/build-apk.yml) — the app authenticates with its
# Supabase JWT instead. The fallback exists only until the Day-30
# re-ship, then it is removed. Rotate the value at Day-30 activation:
# every already-distributed APK holds the old one.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=

# Signup proof signing key (run-2 R1c) — dedicated server-only key
# for the HMAC proof token minted by verify-code. Set in the hosting
# dashboard; never in the app, never gates any route. Falls back to
# API_SECRET when unset (so proofs work from Day-30 activation even
# if this is never set). Generate one like API_SECRET above.
PROOF_SECRET=

# Admin allowlist (run-2 3.3) — comma-separated Supabase user ids
# allowed to read GET /admin/audit. Unset = nobody is an admin
# (every read is 403). Set in the hosting dashboard, never in the app.
ADMIN_USER_IDS=

# Cloudflare Turnstile secret (run-2 6.3) — server-side only, from
# the Cloudflare dashboard (Turnstile → Settings → Secret key). Until
# it is set, code requests skip human verification with a server
# warning (documented temporary fail-open).
TURNSTILE_SECRET_KEY=

# Supabase anon (publishable) key — used ONLY as the apikey for the
# server-side Auth user lookup (GET /auth/v1/user). It is public by
# design; the service_role key below is what must never leak. When
# unset, the service_role key doubles as the apikey.
SUPABASE_ANON_KEY=

# Local dev port (Vercel ignores this)
PORT=5000

# CORS allowlist, comma-separated. Unset = no CORS headers (fail closed).
CORS_ALLOWED_ORIGINS=

# Debug test-alert route. Default-deny unless exactly "1".
ENABLE_TEST_ALERT=

# Upstash Redis (SafeLife 2.0 Day 2) — serverless Redis for GEO,
# cross-instance rate limits and the safe-places cache.
# Create a database at upstash.com → copy its REST URL + REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (SafeLife 2.0 Day 2) — delayed jobs for delivery retries and
# the escalation ladder (consumers land Day 4 / Day 10).
# Create a token at upstash.com → QStash.
QSTASH_TOKEN=

# Public base URL for QStash callbacks (SafeLife 2.0 Day 4) — where the
# /delivery-retry endpoint lives. Optional: on Vercel, VERCEL_URL is
# used automatically when this is unset. Set it only for a custom domain
# or a local tunnel (e.g. https://abc.ngrok-free.app). No trailing slash.
PUBLIC_BASE_URL=

# Supabase Postgres (SafeLife 2.0 Day 3) — sos_alerts + audit_events
# tables (supabase/migrations/20261026080000_sos_alerts_audit.sql).
# SUPABASE_URL is the project URL (https://<ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the service_role key from Supabase →
# Settings → API. SERVER-SIDE ONLY: it bypasses RLS — never put it in
# the mobile app, never commit it. Until both are set, alerts live in
# instance memory only and audit stays stdout-only (no behavior change).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
