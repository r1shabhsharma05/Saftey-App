{
  "expo": {
    "name": "SafeLife",
    "slug": "safelife-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safelifeai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#021211",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rishabh.safelifeai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#021211",
          "dark": {
            "backgroundColor": "#021211"
          }
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafeLife uses your location to send SOS alerts and show nearby safe places."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SafeLife lets you set a profile photo from your gallery."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "SafeLife lets you pick emergency contacts to receive your SOS location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "rishabhsharma14426s-team",
    "extra": {
      "eas": {
        "projectId": "f0290930-811f-49c4-960c-fad1abd68b75"
      }
    }
  }
}
