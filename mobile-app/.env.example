# Copy to .env and fill in your values. Never commit .env with real keys.
# Supabase (same project for app + backend)
EXPO_PUBLIC_SUPABASE_URL=https://xkfrsjtfbylhhrvibmxk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL used by the SOS / alert calls.
# PRODUCTION: the deployed backend over https://, e.g.:
EXPO_PUBLIC_BACKEND_URL=https://safelife-backend-rish0000-dots-projects.vercel.app
# LOCAL DEV ONLY (never ship this): your machine's LAN IP over http so the
# phone can reach the dev server, e.g. EXPO_PUBLIC_BACKEND_URL=http://192.168.1.5:5000
# The app refuses non-https URLs in production builds.

# Shared secret for the SafeLife backend API-key auth (must match backend API_SECRET).
# The app sends it as the `x-api-key` header on SOS alert requests.
EXPO_PUBLIC_API_SECRET=
