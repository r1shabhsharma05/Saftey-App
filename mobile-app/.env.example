# Copy to .env and fill in your values. Never commit .env with real keys.
# Supabase (same project for app + backend)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL used by the SOS / alert calls.
# Use your machine's LAN IP so the phone can reach it, e.g.:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.5:5000
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.5:5000
